    {
      "id": "SntMHOxmZiiDIJf8z-r2-",
      "type": "text",
      "x": 1195.7097927215254,
      "y": 102.72351779958564,
      "width": 716.8887235784076,
      "height": 720.9011936450624,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 1609641673,
      "version": 1509,
      "versionNonce": 1748684905,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792179264389,
      "created": 1792178645106,
      "link": null,
      "locked": false,
      "text": "single threaded - queries the crawler_data base for entries that are\nmarked crawled but not_indexed constantly \n\ngets their compressed html in batches, un compresses them, parsers text\nand heading, tokenizes words, gets tokens count and position, stems the\ntokens and removes useless words\n\nsaves to data_base the inverted index with an example record looking\nlike:\nword : cat\npages: \n{\n    pageID : hash of url or hash of html body\n    word postions in document: [1, 5, 3] (needed for full sentence search\nand sinppet generation)\n    tf: 0.4\n}\n{\n    pageID: blah blah blah\n    .....\n    .\n}\n\nsaves to the inverted_tree data base which the query engine has also\naccess to, whenever a request arrives, it takes a snapshot of the tree\nsearch for the results of the word while the indexer can keep updating it\nin the backgorund\n    \n",
      "fontSize": 19.88692947986379,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "single threaded - queries the crawler_data base for entries that are marked crawled but not_indexed constantly \n\ngets their compressed html in batches, un compresses them, parsers text and heading, tokenizes words, gets tokens count and position, stems the tokens and removes useless words\n\nsaves to data_base the inverted index with an example record looking like:\nword : cat\npages: \n{\n    pageID : hash of url or hash of html body\n    word postions in document: [1, 5, 3] (needed for full sentence search and sinppet generation)\n    tf: 0.4\n}\n{\n    pageID: blah blah blah\n    .....\n    .\n}\n\nsaves to the inverted_tree data base which the query engine has also access to, whenever a request arrives, it takes a snapshot of the tree\nsearch for the results of the word while the indexer can keep updating it\nin the backgorund\n    \n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
