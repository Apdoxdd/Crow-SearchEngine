    },
    {
      "id": "pxTHIGuAStO868nXncojk",
      "type": "text",
      "x": -743.0452725959678,
      "y": 96.10395354559628,
      "width": 751.758000467598,
      "height": 900.7618536874305,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 1939680905,
      "version": 2055,
      "versionNonce": 562691497,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792178601510,
      "created": 1792177784253,
      "link": null,
      "locked": false,
      "text": "job:\n\n1) crawl batches of un_crawled pages, returns their htmls\n2) respect robots.txt (not priority)\n3) return the links found in the html resolved against base\n    URL and normalized, only if they belong to the same \n    domain restrict domains outside to not have it wander\n    around the internet blindly.\n4) try not to have everythread bomb the same domain with\n    requests (optional)\n5) only gets html/text nothing else\n\nimplementation:\ntwo types of implementation\n1) thread pool each thread gets its own easy-handle (blocking)\n    - easy to implement once you know concurrency and, we \n        could force a timeout on urls that take too long so\n        the thread doesnt get stuck forever and goes onto \n        the next url in batch\n    - requires a smaller batch size than the alternative and \n      a big thread pool to compensate for the fact that most\n      thread spend most of their time waiting instead of doing\n      work since the delay is in network\n\n2) threadpool with shared mutli-handle (non-blocking)\n    -harder to implement and get right and theres a potential it does\n    not offer that huge of an advantage compared to blocking with\n    reasonable timeout\n    \n    allows for a much bigger batch and smaller thread pool so smaller \n    threads overhead and handling of thousands of request at the \n    same time, threads are doing work all the time \n    ",
      "fontSize": 21.836650998483165,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "job:\n\n1) crawl batches of un_crawled pages, returns their htmls\n2) respect robots.txt (not priority)\n3) return the links found in the html resolved against base\n    URL and normalized, only if they belong to the same \n    domain restrict domains outside to not have it wander\n    around the internet blindly.\n4) try not to have everythread bomb the same domain with\n    requests (optional)\n5) only gets html/text nothing else\n\nimplementation:\ntwo types of implementation\n1) thread pool each thread gets its own easy-handle (blocking)\n    - easy to implement once you know concurrency and, we \n        could force a timeout on urls that take too long so\n        the thread doesnt get stuck forever and goes onto \n        the next url in batch\n    - requires a smaller batch size than the alternative and \n      a big thread pool to compensate for the fact that most\n      thread spend most of their time waiting instead of doing\n      work since the delay is in network\n\n2) threadpool with shared mutli-handle (non-blocking)\n    -harder to implement and get right and theres a potential it does\n    not offer that huge of an advantage compared to blocking with\n    reasonable timeout\n    \n    allows for a much bigger batch and smaller thread pool so smaller \n    threads overhead and handling of thousands of request at the \n    same time, threads are doing work all the time \n    ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
