    {
      "id": "oMCMQbXefwGhx1eHr-2D2",
      "type": "text",
      "x": 296.3761292024892,
      "y": 112.93916526247745,
      "width": 594.1306153838481,
      "height": 672.6935887185921,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 1063450985,
      "version": 3220,
      "versionNonce": 2103492839,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792177230817,
      "created": 1792176100213,
      "link": null,
      "locked": false,
      "text": "1 - Each entry contains:\n    # the normalized resolved URL, is_crawled flag, is_indexed\n        flag, a field for the compressed html for the doc, a hash\n        of the doc url or its content (serves as ID and could\n        help with finding duplicate pages that have differnt urls)\n        and a frequency count of how many times is was refernecd\n        by other pages\n\n2- the database feeds the crawler un-crawled pages based on \n    their frequency count 'descending order'\n    (size of batch depends on how good the crawler is)\n\n3- after the batch is done the crawler returns the html for each\n    page of the batch, we hash that html and check if it does\n    exist in the base, if it does it means that crawled link was \n    redundant and that entry is removed from base.\n\n4- for all the links that werent redundant, we add the comp-\n    ressed html to their entry and tag the is_crawled flag to 1\n\n5- the crawler also adds new un_crawled normalized links that\n    we found in the crawled batch as new entries in the database\n    if a link was mentioned multi-times its added once with a \n    frequency count of 2 and such\n\n6- crawler asks for a new batch of most un_crawled pages with\n    highest frequency rate and the cycle continues.\n\n     ",
      "fontSize": 18.557064516374954,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1 - Each entry contains:\n    # the normalized resolved URL, is_crawled flag, is_indexed\n        flag, a field for the compressed html for the doc, a hash\n        of the doc url or its content (serves as ID and could\n        help with finding duplicate pages that have differnt urls)\n        and a frequency count of how many times is was refernecd\n        by other pages\n\n2- the database feeds the crawler un-crawled pages based on \n    their frequency count 'descending order'\n    (size of batch depends on how good the crawler is)\n\n3- after the batch is done the crawler returns the html for each\n    page of the batch, we hash that html and check if it does\n    exist in the base, if it does it means that crawled link was \n    redundant and that entry is removed from base.\n\n4- for all the links that werent redundant, we add the comp-\n    ressed html to their entry and tag the is_crawled flag to 1\n\n5- the crawler also adds new un_crawled normalized links that\n    we found in the crawled batch as new entries in the database\n    if a link was mentioned multi-times its added once with a \n    frequency count of 2 and such\n\n6- crawler asks for a new batch of most un_crawled pages with\n    highest frequency rate and the cycle continues.\n\n     ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
