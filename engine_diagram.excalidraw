    {
      "id": "QvqbneOFc29xTx0-JAWVT",
      "type": "text",
      "x": 1024.6160150137487,
      "y": -336.6999165202374,
      "width": 582.5625,
      "height": 257.2216115677314,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 1504917769,
      "version": 1030,
      "versionNonce": 7655911,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792178544870,
      "created": 1792177265108,
      "link": null,
      "locked": false,
      "text": "limits on the size of the entries of the database\nto be determined based on max size of disk we would want to have\n\nand if we want the crawling to be a permemnant background process or no\n\n\n*** if you want permenenant crawling with a size limit we could make a temp\n    data_base file that only lives for a couple of batches, and we only \n    save its most frequent results in place of the least equal frequency \n    in the main database then deleting the temp_data base and have\n    that happen automatically!\n\n",
      "fontSize": 15.82902225032193,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "limits on the size of the entries of the database\nto be determined based on max size of disk we would want to have\n\nand if we want the crawling to be a permemnant background process or no\n\n\n*** if you want permenenant crawling with a size limit we could make a temp\n    data_base file that only lives for a couple of batches, and we only \n    save its most frequent results in place of the least equal frequency \n    in the main database then deleting the temp_data base and have\n    that happen automatically!\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
